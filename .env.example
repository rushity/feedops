# Copy to .env for local development. Never commit .env.
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-your-local-env
DATABASE_PATH=instance/feed.db
# AI analysis (Rushik) — placeholders only, never real keys. Optional.
FEEDOPS_AI_ENABLED=true
FEEDOPS_AI_API_KEY=
FEEDOPS_AI_MODEL=gpt-4o-mini
FEEDOPS_AI_BASE_URL=https://api.openai.com/v1
FEEDOPS_AI_TIMEOUT=15
