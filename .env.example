# Copy to .env for local development. Never commit .env.
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-your-local-env
DATABASE_PATH=instance/feed.db
# AI analysis (Groq) — placeholders only, never real keys. Optional.
# 1. Get a free key at https://console.groq.com/keys and put it in .env as GROQ_API_KEY.
# 2. GROQ_MODEL selects the model (verified Production model; free-tier limits can change).
FEEDOPS_AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=15
# Legacy fallbacks (still honoured): FEEDOPS_AI_API_KEY / OPENAI_API_KEY,
# FEEDOPS_AI_MODEL, FEEDOPS_AI_BASE_URL, FEEDOPS_AI_TIMEOUT.
